{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myhaze-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "REPO": "kiizenitc/myhaze" },
  "observability": { "enabled": true }
}
